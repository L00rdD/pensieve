<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".PensieveApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.Pensieve"
        android:usesCleartextTraffic="true">

        <!-- the home screen: HOME makes it the launcher, LEANBACK_LAUNCHER lists it among the apps -->
        <activity
            android:name=".presentation.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the quick panel, over any app -->
        <activity
            android:name=".presentation.QuickPanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.l0rdd.pensieve.panel"
            android:theme="@style/Theme.Pensieve.Panel">
            <intent-filter>
                <action android:name="com.l0rdd.pensieve.QUICK_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- the remote's ⚙ key: SystemUI only hands it to the Google TV home, which is disabled;
             this service sees the key first, in any app, and opens the quick panel. It runs in its
             own process: every key of the remote waits for it, never for the home screen's drawing -->
        <service
            android:name=".presentation.SettingsKeyService"
            android:process=":keys"
            android:exported="false"
            android:label="@string/settings_key_service"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/settings_key_service" />
        </service>
    </application>
</manifest>
